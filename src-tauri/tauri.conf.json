{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "剑网三网络诊断",
  "version": "0.1.0",
  "identifier": "com.jx3.network-diagnostics",
  "build": {
    "beforeDevCommand": "npm run dev:web", "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web", "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "剑网三网络诊断", "width": 1360, "height": 900, "minWidth": 1000, "minHeight": 720, "backgroundColor": "#eef2f6" }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"], "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } } }
}
